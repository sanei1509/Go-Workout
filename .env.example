# Supabase Auth
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# Opcional: fija el redirect OAuth (copia la URL del log al tocar "Continuar con Google")
# EXPO_PUBLIC_AUTH_REDIRECT_URI="exp://127.0.0.1:8081/--/auth/callback"

# Agente entrenador IA
# 'supabase' -> Edge Function desplegada (requiere: supabase secrets set GEMINI_API_KEY=...)
# 'http'     -> server local Deno (EXPO_PUBLIC_AGENT_ENDPOINT=http://10.0.2.2:8000)
# (vacío)    -> mock local, sin red
EXPO_PUBLIC_AGENT_MODE=supabase
